# Firebase Web App (valores públicos de configuración; no usar Service Accounts)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# URL accesible desde el dispositivo, sin barra final. Android Emulator: http://10.0.2.2:3000
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:3000

# OAuth 2.0 Client ID de tipo Web usado por Firebase/Google Sign-In
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
