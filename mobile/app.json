{
  "expo": {
    "name": "EmprendeLink",
    "slug": "emprendelink-mobile",
    "version": "1.0.0",
    "scheme": "emprendelink",
    "orientation": "portrait",
    "icon": "./assets/emprendelink-icon.png",
    "userInterfaceStyle": "light",
    "description": "Aplicación móvil de EmprendeLink",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emprendelink.app"
    },
    "android": {
      "package": "com.emprendelink.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/emprendelink-icon.png"
      }
    },
    "web": {
      "favicon": "./assets/emprendelink-icon.png"
    },
    "plugins": [
      "expo-font",
      "expo-dev-client",
      "@react-native-google-signin/google-signin"
    ],
    "extra": {
      "eas": {
        "projectId": "cce8507a-6bf1-494b-8eac-04b4363c7801"
      }
    },
    "owner": "oneman-teams"
  }
}
