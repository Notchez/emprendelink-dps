# ============================================================
# EmprendeLink - Variables de entorno
# ============================================================
#
# Copiar este archivo como:
#
#   .env.local
#
# Nunca subir .env.local al repositorio.
#
# Cada integrante del equipo debe crear SU PROPIO proyecto
# de Firebase y colocar aquí, en su .env.local, sus propios
# valores.
#
# Ver instrucciones completas:
# docs/FIREBASE_SETUP.md
# ============================================================


# ------------------------------------------------------------
# Firebase Web App
# ------------------------------------------------------------
# Estos valores aparecen en:
# Firebase Console
# > Configuración del proyecto
# > Tus apps
# > SDK setup and configuration
#
# Son utilizados por el Firebase SDK del navegador.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=


# ------------------------------------------------------------
# Firebase Admin SDK
# ------------------------------------------------------------
# CREDENCIAL PRIVADA.
#
# Debe contener el JSON completo de la Service Account
# convertido a una sola línea.
#
# NUNCA compartir este valor.
# NUNCA subirlo a GitHub.
# NUNCA colocarlo dentro de .env.example.
#
# Cada integrante debe generar su propia Service Account
# para su propio proyecto Firebase.
#
# Ver:
# docs/FIREBASE_SETUP.md

FIREBASE_SERVICE_ACCOUNT_JSON=